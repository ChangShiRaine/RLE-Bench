schema_version = "1.4"

# Root-level, not inside a table: these are TaskConfig fields, and a bare key after a
# table header would silently nest under that table.
#
# Development is unscored; evaluation is a single terminal attempt whose score is final,
# so the trial reward is the evaluate step's.
multi_step_reward_strategy = "final"

# THE AGENT CARRIES ITS DEVELOPMENT CONTEXT INTO EVALUATION -- same agent, same session.
# That is `harbor run --resume-trajectory`, which CANNOT be set here: `resume_trajectory`
# lives on the RUN's agent config (harbor/models/trial/config.py), not on a task's
# [agent] table. Every documented invocation in README.md passes it. Harbor fails fast if
# the agent lacks native resume (SUPPORTS_RESUME), which the oracle does -- so the
# documented oracle run omits the flag and reloads its code from disk instead.

# ROOT LEVEL, for the same reason. The code the agent writes is the deliverable, and
# /workspace has no bind mount -- it lives only in the container's writable layer, which
# Harbor deletes at trial end. /logs/artifacts is collected by convention; declaring it
# explicitly would REPLACE that implicit entry, so it stays implicit.
artifacts = ["/workspace"]

[task]
name = "rlebench/task01-@@LEVEL@@-@@SLUG@@"
version = "1.0.0"
description = "RoboCasa speed-run (@@LEVEL@@): learn to @@GOAL@@ with as little simulator interaction as possible, then pass a single terminal evaluation. The agent writes whatever code it likes and reaches the simulator only through a metered socket. @@LEVEL_BLURB@@"
authors = [{ name = "Haitong Ma", email = "haitongma@g.harvard.edu" }]
keywords = ["robotics", "robocasa", "robosuite", "mujoco", "simulation", "control", "sample-efficiency"]

[metadata]
category = "robotics-control"
difficulty = "hard"
tags = ["metered-simulator", "sample-efficiency", "multi-step", "gpu"]
# Calibration context for whoever tunes this task. Not agent-facing.
difficulty_explanation = "Sample-efficiency under a metered simulator: the agent must learn to solve @@ROBOCASA_TASK@@, with one irreversible evaluation. Harness level @@LEVEL@@. @@LEVEL_BLURB@@ The task, the evaluation plan and the reward weights are identical at every level, so scores across L1/L2/L3 are directly comparable and the difference between them is what the harness bought. Reference anchors: uniform-random actions succeed 0% of the time, and a privileged hand-written scripted controller reached ~48% on the most scriptable atomic task."


[[steps]]
name = "develop"
[steps.agent]
# 8 hours. MUST be kept in step with RLEBENCH_DEVELOP_SECONDS below, which is what the
# daemon reports to the agent -- Harbor enforces the timeout, the daemon only reports it,
# and a task cannot read its own step config back at run time.
timeout_sec = 28800.0
user = "agent"
[steps.verifier]
timeout_sec = 300.0

# Open the scored phase, as root, once the develop agent phase has ended. Collect hooks
# run inside the agent container after the step's agent finishes and before the next step
# starts -- exactly the window where "development is over" becomes true.
#
# This is the harness's plane: harness.control ships only in the root-only
# /opt/private tree, and the daemon refuses these ops to any caller whose uid is not 0.
[[steps.verifier.collect]]
command = "PYTHONPATH=/opt/private python -m harness.control open-evaluation"
user = "root"
timeout_sec = 60.0

[[steps]]
name = "evaluate"
[steps.agent]
# Mirrored by RLEBENCH_EVALUATE_SECONDS below; see the develop step's note.
timeout_sec = 3600.0
user = "agent"
[steps.verifier]
timeout_sec = 1800.0

# Seal the ledger as root once the agent phase ends. Harbor runs collect hooks inside the
# agent container before downloading /logs/artifacts and before stopping it, which is the
# window this needs: the scorer cannot read an unsealed ledger, and sealing must not
# depend on the agent making a cleanup call. It is worth no reward -- it happens
# unconditionally, so it says nothing about whether the agent did anything.
#
# Only on THIS step -- a seal hook on `develop` would kill the daemon before the
# evaluation ever ran.
[[steps.verifier.collect]]
command = "/opt/seal_ledger.sh"
user = "root"
timeout_sec = 120.0

[environment]
# Prebuilt so all task variants share one image and nothing rebuilds per task.
# Build with: make task01
docker_image = "rlebench-task01-@@LEVEL_TAG@@-agent:dev"
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 16384
# The ENVIRONMENT BASELINE, which is what agent *setup* runs under. Harbor's "installed"
# agents bootstrap themselves inside this container, and `agent.setup()` is not wrapped
# in a phase network policy (trial/trial.py) -- only agent.run() and the verifier are. So
# a no-network baseline makes every self-installing agent fail mid-download; keeping this
# open is what makes the task agent-neutral. Integrity rests on uid isolation and the
# hash-chained ledger, not on the network.
network_mode = "public"
# EGL rendering needs a GPU. gpu_types is pinned because physics is CPU-deterministic but
# PIXELS depend on the GPU model, and a vision-based solution must be scored against the
# pixels it was developed against.
gpus = 1
gpu_types = ["H100"]

# The AGENT RUN phase. Deny-all by default: the runner opens exactly the model API with
# --allow-agent-host, which merges into this allowlist. So the open baseline above buys
# setup its installer and nothing more, which also closes the obvious shortcut of
# downloading a pretrained RoboCasa policy mid-run.
[agent]
# MUST match [steps.agent].user. Agent *setup* runs under the TASK-level agent user
# (trial.py `_prepare`), while each step's agent phase runs under the STEP-level one.
user = "agent"
network_mode = "allowlist"
allowed_hosts = []

# ---------------------------------------------------------------------------
# TUNABLE KNOBS.
#
# Harbor's TaskConfig has no generic task-parameter mechanism, so every knob travels as
# an environment variable. WHICH TABLE A KNOB GOES IN IS A DECISION ABOUT WHO CAN READ
# IT:
#
#   [environment.env]  reaches the whole container, INCLUDING the agent -- it can read
#                      its own /proc/self/environ. Only put things here that the agent
#                      is told anyway.
#   [verifier.env]     reaches the verifier's exec environment only. Scoring weights
#                      belong here.
#   daemon-only        set below but UNSET by entrypoint.sh before the agent is exec'd.
#                      The daemon has already captured its environ by then.
# ---------------------------------------------------------------------------

[environment.env]
# The RoboCasa task. A PURE RUNTIME STRING -- the daemon takes it as `--task` and nothing
# downstream is task-specific, so the subtask directories at a level share one image
# and differ only here.
RLEBENCH_TASK = "@@ROBOCASA_TASK@@"

# WHICH HARNESS THIS RUN GETS. Agent-readable on purpose: the agent is told its level.
# It does NOT choose the harness -- the image did, at build time, by deciding which
# modules landed in the agent-readable tree. entrypoint.sh refuses to start if the two
# disagree.
RLEBENCH_LEVEL = "@@LEVEL@@"

# Interaction budget. The scorer reads the budget back out of the ledger's start record
# -- written by the root daemon before the agent runs -- so overriding it rescales the
# efficiency term rather than invalidating it.
RLEBENCH_INTERACTION_STEPS = "50000"

# Per-trial step ceiling. RoboCasa's env never signals done (create_env sets
# ignore_done=True), so this cap is what actually ends a trial at the horizon.
RLEBENCH_MAX_STEPS_PER_TRIAL = "1000"

# WALL-CLOCK BUDGETS, reported to the agent by sim.status() and sim.task_info(). These
# MIRROR the [steps.agent] timeout_sec values above and must be changed with them. Both
# are multiplied by RLEBENCH_TIMEOUT_MULT, which the Makefile sets from the same
# variable it passes to `harbor run --agent-timeout-multiplier`. Set either to 0 to stop
# reporting a clock at all, rather than reporting a wrong one.
RLEBENCH_DEVELOP_SECONDS = "28800"
RLEBENCH_EVALUATE_SECONDS = "3600"

# NOTHING DAEMON-ONLY BELONGS IN THIS TABLE. Anything here is readable by the agent out
# of its own /proc/self/environ, and unsetting it in entrypoint.sh does NOT take it away:
# `docker exec` builds each new process's environment from the container's stored config
# rather than from PID 1's live environ, and Harbor starts the agent with `docker exec`.
#
# The evaluation plan and the seed salt travel by the root-only file
# /opt/private/eval_plan.txt instead. The defaults in tasks/task01/harness/config.py
# apply when it is absent, which is the normal case:
#
#     plan=1x1,2x1,3x1,4x1,5x1
#     salt=<per-deployment secret, or omit>
#
# Write it into the image, or bind-mount it; /opt/private is root:root 0700, so the
# agent cannot traverse to it. check_isolation.sh asserts both halves.

[environment.healthcheck]
# The agent must not start before EVERY service it is given is listening. The entrypoint
# waits for them, but that only gates the container's *command* -- Harbor reaches the
# agent with `docker exec`, which does not wait for it.
#
# The entrypoint writes this marker once the metering daemon is bound AND, at L2 and L3,
# the perception service has finished loading its models. Testing the marker rather than a
# socket keeps it level-agnostic: the daemon binds its socket up to a minute before SAM3
# and Contact-GraspNet are answering.
#
# Warm-up constructs a RoboCasa env (~40 s: MuJoCo compile plus first EGL context) and the
# models take another ~30-60 s in parallel. The budget (start_period + retries * interval
# = 360 s) must outlive the entrypoint's own 300 s perception deadline, so a slow but
# successful model load is never cut off here first. A service that never binds is a
# broken environment, and failing the healthcheck is the right way to say so.
command = "test -f /run/rlebench/ready"
interval_sec = 3.0
timeout_sec = 10.0
start_period_sec = 30.0
start_interval_sec = 3.0
retries = 110

# TASK-LEVEL collect hook: runs in the agent container before EVERY step's artifact
# download, as root. Two problems, one chmod.
#
# READABILITY: agent CLIs write their session transcripts mode 0600, so the run's owner
# could not otherwise read the richest record of what their agent did.
#
# ARCHIVING: Harbor moves these trees out of the mounts at every step boundary, ACROSS
# directories, as an ordinary user. Removing a file from a directory needs write on that
# DIRECTORY, and agents create directories here -- so `a+rX` is not enough (X never
# grants write to a directory) and the move fails with EACCES after a successful run.
#
# `w` costs nothing: the agent already has write on these mounts, and nothing in them is
# scored -- the verifier reads the root-only ledger at /var/lib/rlebench/cost.jsonl.
[[verifier.collect]]
command = "chmod -R a+rwX /logs/agent /logs/artifacts 2>/dev/null; true"
user = "root"
timeout_sec = 60.0

[verifier]
# SHARED environment (the default), and that is a security decision, not a convenience.
#
# The verifier runs as root in the agent's own container, so it reads the AUTHORITATIVE
# ledger in place at /var/lib/rlebench/cost.jsonl -- root:root 0700, which the agent's
# uid cannot write. A `separate` verifier physically cannot see that file: the only
# channel Harbor gives it is /logs/artifacts, which Harbor chmods to 0777 so tasks can
# publish from it, so the reward would be computed from a file the agent can rewrite.
#
# The cost is that an archived run cannot be re-scored on a plain CPU box.
timeout_sec = 1800.0
network_mode = "no-network"

# REWARD WEIGHTS, on the verifier's own channel so the agent cannot read how it is being
# weighted.
#
#   reward = W_OUTCOME * success_rate
#          + W_EFFICIENCY * success_rate * (1 - development_steps / interaction_budget)
#
# They sum to 1.0, so solving every trial having spent nothing scores exactly 1.0.
# Efficiency is SCALED BY the success rate rather than added independently -- otherwise
# the cheapest possible run, which never interacts and never succeeds, would collect the
# whole efficiency term for doing nothing. Identical at every level, so L1/L2/L3 scores
# are directly comparable.
[verifier.env]
RLEBENCH_W_OUTCOME = "0.80"
RLEBENCH_W_EFFICIENCY = "0.20"
