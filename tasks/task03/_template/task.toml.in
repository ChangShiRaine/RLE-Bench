schema_version = "1.4"
artifacts = ["/workspace"]

[task]
name = "rlebench/task03-@@SLUG@@"
version = "1.0.0"
description = "@@GOAL@@ within one metered attempt; submit the current scene when satisfied. @@LEVEL_BLURB@@"
authors = [{ name = "Haitong Ma", email = "haitongma@g.harvard.edu" }]
keywords = ["robotics", "robosuite", "mujoco", "physical-reasoning", "sample-efficiency"]

[metadata]
category = "robotics-control"

[agent]
user = "agent"
timeout_sec = 32400.0
network_mode = "allowlist"
allowed_hosts = []

[environment]
docker_image = "rlebench-task03-agent:dev"
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 16384
gpus = 1
# Agent installers run before the restricted agent phase.
network_mode = "public"

[environment.env]
RLEBENCH_TASK = "@@TASK@@"
RLEBENCH_INTERACTION_STEPS = "@@INTERACTION_STEPS@@"
RLEBENCH_SECONDS = "32400"

[environment.healthcheck]
command = "test -f /run/rlebench/ready"
interval_sec = 3.0
timeout_sec = 10.0
start_period_sec = 30.0
start_interval_sec = 3.0
retries = 110

[verifier]
user = "root"
timeout_sec = 1800.0
network_mode = "no-network"

# The root verifier reads the authoritative ledger in the shared container.
[[verifier.collect]]
command = "/opt/seal_ledger.sh"
user = "root"
timeout_sec = 120.0

[[verifier.collect]]
command = "chmod -R a+rwX /logs/agent /logs/artifacts 2>/dev/null; true"
user = "root"
timeout_sec = 60.0

[verifier.env]
