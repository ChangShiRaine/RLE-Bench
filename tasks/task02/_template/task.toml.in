schema_version = "1.4"

# Root-level, not inside a table: these are TaskConfig fields, and a bare key after a
# table header would silently nest under that table.
#
# EVERY STEP'S VERIFIER WRITES A CUMULATIVE REWARD, read off the ledger as it then stands,
# so "final" takes the last step that ran, which is always the most complete number
# available. Any step can abort the chain (MultiStepTrial._should_stop_after_step), and a
# task that scored only at the end would leave a run that crashed part-way unscored.
# "mean" would average cumulative snapshots of one run, which is not a quantity.
multi_step_reward_strategy = "final"

# THE AGENTS MUST NOT SHARE CONTEXT -- run WITHOUT `--resume-trajectory`.
#
# This is the whole task, and the one thing task.toml cannot enforce: `resume_trajectory`
# lives on the RUN's agent config (harbor/models/trial/config.py), not a task's [agent]
# table. Absent the flag, Harbor empties /logs/agent between steps and each step gets a
# genuinely fresh session. Passing it would carry the development agent into every graded
# trial, and the question -- can another agent pick this harness up from the manual alone
# -- would stop being asked.

# ROOT LEVEL, for the same reason as above, and on the DEVELOP STEP only (see [[steps]]).
# The harness the development agent writes is the deliverable; /workspace has no bind
# mount, so it lives only in the container's writable layer, which Harbor deletes at trial
# end. Declaring it task-level would archive the whole workspace once per step.

[task]
name = "rlebench/task02-@@SLUG@@"
version = "1.0.1"
description = "RoboCasa harness engineering: practise on the members of one composite kitchen-task activity group, write a controller library and a manual, then hand it to a series of fresh agents -- each with no memory of the development session -- who each get one shot at a held-out member of that group they have never seen."
authors = [{ name = "Haitong Ma", email = "haitongma@g.harvard.edu" }]
keywords = ["robotics", "robocasa", "robosuite", "mujoco", "simulation", "control", "generalisation", "tool-use"]

[metadata]
category = "robotics-control"
difficulty = "hard"
tags = ["metered-simulator", "generalisation", "multi-step", "gpu"]
# Calibration context for whoever tunes this task. Not agent-facing.
difficulty_explanation = "Transfer under a metered simulator. The agent develops against the composite RoboCasa tasks of one activity group and is graded on the group's held-out member over several independent trials, each driven by a fresh agent whose only inheritance is /workspace/agent_harness. How many of each depends on the adopted group and config.TRIALS_PER_TASK, so no count is quoted here. Composite tasks are strictly harder than atomic ones, which is why trials are graded by stage credit rather than binary success -- see tasks/task02/harness/stages.py. A do-nothing agent scores exactly 0.0 after reset-normalisation."

# ---------------------------------------------------------------------------
# STEPS. One development phase, then one step per graded trial.
#
# The step boundary IS the trial boundary: a root collect hook opens the evaluation
# between steps, so the graded task is built after the development agent has exited. The
# agent has no op that can reach it -- `next_trial` is uid-0 only
# (tasks/task02/harness/service.py CONTROL_OPS).
# ---------------------------------------------------------------------------

[[steps]]
name = "develop"
# BEFORE any [steps.*] header: a bare key after a table header nests under that table, so
# three lines lower this would silently become `steps.agent.artifacts`, which Harbor parses
# clean and ignores.
#
# The harness and its manual, collected once. Everything the evaluation agents inherit is
# in here. On the develop step alone -- at task level it would archive the whole workspace
# once per step.
artifacts = ["/workspace"]
[steps.agent]
# 8 hours. MUST be kept in step with RLEBENCH_DEVELOP_SECONDS below, which is what the
# daemon reports to the agent -- Harbor enforces the timeout, the daemon only reports it,
# and a task cannot read its own step config back at run time.
timeout_sec = 28800.0
user = "agent"
[steps.verifier]
timeout_sec = 300.0

# Open the scored phase, as root, once the develop agent phase has ended. Collect hooks
# run inside the agent container AFTER the step's agent finishes and BEFORE the next step
# starts, which is exactly the window where "development is over" becomes true.
#
# This is the harness's plane: harness.control ships only in the root-only
# /opt/private tree, and the daemon refuses these ops to any caller whose uid is not 0.
# The agent's own signal is end_development(), which touches no simulator.
#
# PYTHONSAFEPATH=1 IS NOT DECORATION. Harbor execs collect hooks from the image WORKDIR,
# /workspace, and `python -m` prepends the CWD to sys.path AHEAD of PYTHONPATH -- so a
# package the agent wrote at /workspace/harness would answer this import instead of the
# root-only tree. The hook then dies, and Harbor treats a failed collect hook as best
# effort: every later step runs against a daemon still in the development phase and the
# run is recorded as a completed zero. The flag drops the CWD from sys.path entirely.
[[steps.verifier.collect]]
command = "PYTHONSAFEPATH=1 PYTHONPATH=/opt/private python -m harness.control open-evaluation"
user = "root"
# Generous: opening trial 1 builds a RoboCasa composite scene (~20-40 s).
timeout_sec = 180.0

# --- the graded trials ---------------------------------------------------------
# One step per trial: a fresh agent, the held-out task, one shot each. `next-trial` scores
# what that step's agent drove and opens the next; the seal closes the ledger after the
# last. Both are root-only and neither is the agent's to call.
#
# GENERATED, together with config.TRIALS_PER_TASK and the steps/ directories, by
#     python tasks/task02/build_groups.py --trials N
# Do not hand-edit between the markers: `--check` asserts all three agree, because a step
# list longer than the plan runs `next-trial` past its end and a shorter one leaves trials
# unreached, which score 0.

# --- BEGIN GENERATED EVAL STEPS (tasks/task02/build_groups.py) ---

[[steps]]
name = "eval_01"
[steps.agent]
timeout_sec = 3600.0
user = "agent"
[steps.verifier]
timeout_sec = 600.0
[[steps.verifier.collect]]
command = "PYTHONSAFEPATH=1 PYTHONPATH=/opt/private python -m harness.control next-trial"
user = "root"
timeout_sec = 180.0

[[steps]]
name = "eval_02"
[steps.agent]
timeout_sec = 3600.0
user = "agent"
[steps.verifier]
timeout_sec = 600.0
[[steps.verifier.collect]]
command = "PYTHONSAFEPATH=1 PYTHONPATH=/opt/private python -m harness.control next-trial"
user = "root"
timeout_sec = 180.0

[[steps]]
name = "eval_03"
[steps.agent]
timeout_sec = 3600.0
user = "agent"
[steps.verifier]
timeout_sec = 600.0
[[steps.verifier.collect]]
command = "PYTHONSAFEPATH=1 PYTHONPATH=/opt/private python -m harness.control next-trial"
user = "root"
timeout_sec = 180.0

[[steps]]
name = "eval_04"
[steps.agent]
timeout_sec = 3600.0
user = "agent"
[steps.verifier]
timeout_sec = 600.0
[[steps.verifier.collect]]
command = "PYTHONSAFEPATH=1 PYTHONPATH=/opt/private python -m harness.control next-trial"
user = "root"
timeout_sec = 180.0

[[steps]]
name = "eval_05"
[steps.agent]
timeout_sec = 3600.0
user = "agent"
[steps.verifier]
timeout_sec = 600.0
[[steps.verifier.collect]]
command = "PYTHONSAFEPATH=1 PYTHONPATH=/opt/private python -m harness.control next-trial"
user = "root"
timeout_sec = 180.0

# Seal AFTER the last trial is scored, and ONLY here. Sealing kills the daemon,
# which serves every step, so on any earlier one it would strand the trials
# behind it.
#
# NOTE that sealing is worth NO reward. It happens unconditionally, so it says
# nothing about whether the agent did anything.
[[steps.verifier.collect]]
command = "/opt/seal_ledger.sh"
user = "root"
timeout_sec = 120.0

# --- END GENERATED EVAL STEPS ---

[environment]
# Prebuilt and shared by every group; RLEBENCH_GROUP below selects this one. Build
# with: make task02
docker_image = "rlebench-task02-agent:dev"
build_timeout_sec = 1800.0
cpus = 8
memory_mb = 24576
# The ENVIRONMENT BASELINE, which is what agent *setup* runs under. Harbor's "installed"
# agents bootstrap themselves inside this container, and `agent.setup()` is deliberately
# NOT wrapped in a phase network policy (trial/trial.py) -- only agent.run() and the
# verifier are. So `--allow-agent-host` cannot reach setup, and a no-network baseline makes
# every self-installing agent fail with a TLS cut mid-download. Keeping this open is what
# makes the task agent-neutral.
#
# This does NOT loosen the task's integrity, which rests on uid isolation and the
# hash-chained ledger, not on the network.
network_mode = "public"
# EGL rendering needs a GPU. gpu_types is pinned because physics is CPU-deterministic but
# PIXELS depend on the GPU model, and a vision-based controller must be scored against the
# pixels it was developed against.
gpus = 1
gpu_types = ["H100"]

# The AGENT RUN phase. Deny-all by default: the runner opens exactly the model API with
# --allow-agent-host, which merges into this allowlist. So the open baseline above buys
# setup its installer and nothing more, which also closes the obvious shortcut of
# downloading a pretrained RoboCasa policy mid-run.
[agent]
# MUST match [steps.agent].user. Agent *setup* runs under the TASK-level agent user
# (trial.py `_prepare`), while each step's agent phase runs under the STEP-level one.
user = "agent"
network_mode = "allowlist"
allowed_hosts = []

# ---------------------------------------------------------------------------
# TUNABLE KNOBS.
#
# Harbor's TaskConfig has no generic task-parameter mechanism, so every knob travels as an
# environment variable. WHICH TABLE A KNOB GOES IN IS A DECISION ABOUT WHO CAN READ IT:
#
#   [environment.env]  reaches the whole container, INCLUDING the agent -- it can read
#                      its own /proc/self/environ. Only put things here that the agent is
#                      told anyway.
#   [verifier.env]     reaches the verifier's exec environment only.
# ---------------------------------------------------------------------------

[environment.env]
#
# `${VAR:-default}` IS LOAD-BEARING, NOT DECORATION. Harbor resolves these templates from
# the launching shell (`harbor/utils/env.py:resolve_env_vars`); a bare value pins the knob
# and silently discards whatever the operator set. Any knob meant to be overridable per run
# must be templated.
#
# Development interaction budget, in env steps. A HARD CAP AND NOTHING ELSE -- unlike
# task01, task02 pays no reward for frugality. This is the scarcity the task is built
# around: deliberately short of carrying every training task to completion. If a run ends
# with it unspent, the phase clock below is too low rather than the agent too idle -- raise
# both clocks together. See config.py INTERACTION_STEPS.
RLEBENCH_INTERACTION_STEPS = "${RLEBENCH_INTERACTION_STEPS:-75000}"

# Per-trial step ceiling. RoboCasa's env never signals done (create_env sets
# ignore_done=True), so this cap is what actually ends a trial at the horizon.
#
# MUST MATCH config.MAX_STEPS_PER_TRIAL -- asserted in tests. Above RoboCasa's own 1000,
# which is a teleop-demo horizon; sized to hold a whole composite procedure including the
# drives between its fixtures.
RLEBENCH_MAX_STEPS_PER_TRIAL = "${RLEBENCH_MAX_STEPS_PER_TRIAL:-5000}"

# How many development environments stay resident. Each costs ~20-40 s to build and is not
# small; this bounds residency, never which tasks are reachable.
RLEBENCH_ENV_CACHE = "${RLEBENCH_ENV_CACHE:-3}"

# The observation resolutions are NOT knobs: they are part of the contract the agent is
# graded against. Change them in tasks/task02/harness/config.py and rebuild.

# WALL-CLOCK BUDGETS, reported to the agent by sim.status() and sim.task_info().
#
# These MIRROR the [steps.agent] timeout_sec values above and must be changed with them.
# Both are multiplied by RLEBENCH_TIMEOUT_MULT, which the Makefile sets from the same
# variable it passes to `harbor run --agent-timeout-multiplier`, so one knob keeps them in
# step. Set either to 0 to stop reporting a clock at all; the agent is then told nothing
# about time rather than told something wrong.
#
# RLEBENCH_TRIAL_SECONDS is per TRIAL, not for the whole evaluation: each trial is its own
# step with its own agent, and the daemon restarts the clock at each `next-trial`.
RLEBENCH_DEVELOP_SECONDS = "${RLEBENCH_DEVELOP_SECONDS:-28800}"
RLEBENCH_TRIAL_SECONDS = "${RLEBENCH_TRIAL_SECONDS:-3600}"

# Where the development agent is told to leave its harness. The verifier reports whether a
# manual was found there; it is never scored.
RLEBENCH_HARNESS_DIR = "/workspace/agent_harness"

# --- NEITHER SPLIT IS HERE, AND NEITHER CAN BE --------------------------------
#
# The splits of every group are a table in tasks/task02/harness/config.py, which ships
# only in the root-only /opt/private tree. This selects the entry, and names nothing the
# agent is not told anyway: the group, whose training tasks `sim.list_tasks()` lists.
RLEBENCH_GROUP = "@@SLUG@@"
#
# RULE: nothing secret may be added to [environment.env]. Ever. A value there reaches the
# agent through `docker exec`, which builds its environment from the container's config --
# so an entrypoint that unsets it changes nothing.

[environment.healthcheck]
# No agent must start before the metering daemon is listening. The entrypoint waits for the
# socket, but that only gates the container's *command* -- Harbor reaches the agent with
# `docker exec`, which does not wait for it.
#
# Warm-up constructs a RoboCasa env (~40 s: MuJoCo compile plus first EGL context), so the
# budget here is deliberately generous. A daemon that never binds is a broken environment,
# and failing the healthcheck is the right way to say so.
command = "test -S /run/rlebench/toolsmith.sock"
interval_sec = 3.0
timeout_sec = 10.0
start_period_sec = 30.0
start_interval_sec = 3.0
retries = 60

# TASK-LEVEL collect hook: runs in the agent container before EVERY step's artifact
# download, as root. Two problems, one chmod.
#
# READABILITY: agent CLIs write their session transcripts mode 0600, so the run's owner
# could not otherwise read the richest record of what each agent did.
#
# ARCHIVING, which is the one that fails a trial: Harbor moves these trees out of the
# mounts at every step boundary, ACROSS directories, as an ordinary user. Removing a file
# from a directory needs write on that DIRECTORY, and agents create directories here, so
# `a+rX` is not enough -- X never grants write to a directory, and the move dies with
# EACCES after a completely successful run.
#
# `w` costs nothing here: the agent already has write on these mounts, and nothing in them
# is scored -- the verifier reads the root-only ledger at /var/lib/rlebench/cost.jsonl.
[[verifier.collect]]
command = "chmod -R a+rwX /logs/agent /logs/artifacts 2>/dev/null; true"
user = "root"
timeout_sec = 60.0

[verifier]
# SHARED environment (the default), and that is a security decision, not a convenience.
#
# The verifier runs as root in the agent's own container, so it reads the AUTHORITATIVE
# ledger in place at /var/lib/rlebench/cost.jsonl -- root:root 0700, which no agent's uid
# can write. A `separate` verifier physically cannot see that file: the only channel Harbor
# gives it is /logs/artifacts, which Harbor chmods to 0777 so tasks can publish from it, so
# the reward would come from a file the agent can rewrite.
#
# The cost is that an archived run cannot be re-scored on a plain CPU box.
timeout_sec = 600.0
network_mode = "no-network"

# No reward weights. The reward is the mean stage score over the planned trials and has
# no free parameters -- see tasks/task02/harness/scoring.py. Development interaction is a
# hard cap that earns nothing, so there is no efficiency term to weight against outcome.
[verifier.env]
RLEBENCH_HARNESS_DIR = "/workspace/agent_harness"
