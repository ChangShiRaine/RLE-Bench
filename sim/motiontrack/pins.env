# Pins for the task04 motion-tracking layer. THE single source of truth: sourced
# by sim/motiontrack/motiontrack.sh and passed to both Dockerfiles as --build-arg, so the
# dev venv and the two images cannot drift apart (CLAUDE.md invariant #3).
#
# task04 does not use requirements.txt. mujoco-warp requires mujoco >= 3.9 and
# the repo pins 3.5.0 everywhere else, so this layer gets its own venv --
# the same split sim/robocasa made for the opposite reason.

# Shared by trainer and evaluator: both sides must agree on the physics model.
MUJOCO_VER=3.11.0
NUMPY_VER=2.5.1

# Agent image only -- GPU-batched training.
MJWARP_VER=3.11.0
WARP_VER=1.16.0
TORCH_VER=2.10.0+cu128
TORCH_INDEX=https://download.pytorch.org/whl/cu128

# Both images: the agent runs the dev evaluator, the verifier runs the real one.
ONNXRUNTIME_VER=1.28.0
# Reading the submitted graph (param budget) and writing it (torch's exporter).
ONNX_VER=1.20.0
ONNXSCRIPT_VER=0.7.1

# Vendored assets. The G1 model is the ONE robot description used by training and
# evaluation alike -- no URDF/MJCF pair to keep in sync, unlike the base repo.
MENAGERIE_SHA=c1a4eeb85694ae1dffe33ff1797d4e528928a133
LAFAN1_REV=ce1572906efe6157840e8474d5a0d7aa87481e74

# Backwards-compatible default used by the shared images. The five scored clips and
# their frame ranges live in motions.tsv; task.toml selects one NPZ at runtime. Every
# other retargeted clip stays available to the agent for pretraining or conversion.
MOTIONTRACK_MOTION=dance1_subject2
MOTIONTRACK_FRAMES=122:722
MOTIONTRACK_INPUT_FPS=30
MOTIONTRACK_FPS=50
